# 네이버 클라우드 플랫폼(NCP) > AI·NAVER API > Maps 에서 발급받은 값을 입력하세요.
# 콘솔: https://console.ncloud.com/naver-service/application

# 지도(Web Dynamic Map) 표시용 - 프론트엔드에서 사용, 서비스 URL에 도메인 등록 필요
NAVER_MAPS_CLIENT_ID=여기에_Client_ID_입력

# 주소 -> 좌표 변환(Geocoding) 용 - 서버에서만 사용
NAVER_MAPS_CLIENT_SECRET=여기에_Client_Secret_입력

# 서버 포트 (선택)
PORT=3000

# ---------- 보안 설정 (필수) ----------
# 관리자 계정 - 거래처 등록/수정/삭제 가능 (배차 담당자 등)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=반드시_강력한_비밀번호로_변경하세요

# 기사님 계정 - 거래처 조회만 가능 (등록/수정/삭제 불가)
VIEWER_USERNAME=driver
VIEWER_PASSWORD=이것도_반드시_강력한_비밀번호로_변경하세요

# 세션 암호화에 쓰이는 임의의 긴 문자열. 아래 명령으로 생성한 값을 붙여넣으세요.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=여기에_긴_랜덤_문자열_입력

# 배포(Render 등) 환경에서는 NODE_ENV=production 으로 설정하세요.
# (HTTPS 환경에서만 세션 쿠키가 secure 모드로 전송되도록 하기 위함)
NODE_ENV=development
